pkgname=kytyps5-studio
pkgver=1.0.0
pkgrel=1
pkgdesc='Linux desktop manager for KytyPS5 sources, builds, and games'
arch=('x86_64')
url='https://github.com/Febsho/KytyPs5-Studio'
license=('MIT')
options=('!lto')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg' 'xdg-utils' 'xdg-desktop-portal' 'zenity' 'libnotify' 'libsecret' 'xdotool')
makedepends=('nodejs' 'npm' 'rust' 'cargo' 'appmenu-gtk-module' 'xdotool')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

sanitize_rust_flags() {
  printf '%s' "$1" | sed -E \
    's/(^|[[:space:]])-C[[:space:]]+target-cpu=[^[:space:]]+/\1-C target-cpu=x86-64/g'
}

sanitize_cpu_flags() {
  printf '%s' "$1" | sed -E \
    -e 's/(^|[[:space:]])-(march|mcpu)=[^[:space:]]+/\1-march=x86-64/g' \
    -e 's/(^|[[:space:]])-mtune=[^[:space:]]+/\1-mtune=generic/g'
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm ci
  # CachyOS and custom makepkg.conf files may target a specific CPU (for
  # example native, znver4, or skylake). Keep release packages runnable across
  # x86_64 systems without changing the user's global build configuration.
  export RUSTFLAGS="$(sanitize_rust_flags "${RUSTFLAGS:-}")"
  export CFLAGS="$(sanitize_cpu_flags "${CFLAGS:-}")"
  export CXXFLAGS="$(sanitize_cpu_flags "${CXXFLAGS:-}")"
  npm run tauri build -- --no-bundle
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 src-tauri/target/release/kytyps5-studio "$pkgdir/usr/bin/kytyps5-studio"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/kytyps5-studio.png"
  install -Dm644 packaging/arch/kytyps5-studio.desktop "$pkgdir/usr/share/applications/kytyps5-studio.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/kytyps5-studio/LICENSE"
}
